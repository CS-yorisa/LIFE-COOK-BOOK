{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Format Code",
			"type": "shell",
			"command": "pnpm",
			"args": ["format"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Lint Code",
			"type": "shell",
			"command": "pnpm",
			"args": ["lint"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": ["$eslint-stylish"]
		},
		{
			"label": "Lint Fix",
			"type": "shell",
			"command": "pnpm",
			"args": ["lint:fix"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Format Check",
			"type": "shell",
			"command": "pnpm",
			"args": ["format:check"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Type Check",
			"type": "shell",
			"command": "pnpm",
			"args": ["check"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": ["$tsc"]
		}
	]
}
